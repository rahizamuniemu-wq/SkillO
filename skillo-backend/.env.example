# ─────────────────────────────────────────────────────────────────────────────
# SkillO Backend – Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Find this in: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Use the "Transaction" pooler URI (port 6543) for serverless; direct (port 5432) for long-running.
DATABASE_URL=postgresql://postgres:jos4Ay0DCb1ucckv@db.tzkegqiapgorahnrjeif.supabase.co:5432/postgres
# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRY_HOURS=72

# ── Email Provider ────────────────────────────────────────────────────────────
# Choose one: smtp | resend | sendgrid
EMAIL_PROVIDER=smtp

# ── SMTP (e.g. Gmail) ─────────────────────────────────────────────────────────
# Gmail: enable 2FA → generate an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=you@gmail.com

# ── Resend (https://resend.com) ───────────────────────────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=SkillO <noreply@yourdomain.com>

# ── SendGrid (https://sendgrid.com) ──────────────────────────────────────────
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM=noreply@yourdomain.com

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=SkillO
FRONTEND_URL=http://localhost:3000

# ── Gemini task suggestions ──────────────────────────────────────────────────
# Used for task skill, points, submission-format, and grounded learning-resource suggestions.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
